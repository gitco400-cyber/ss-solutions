# Set these to the local values printed by `supabase start`.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional public contact overrides; the site has built-in fallbacks.
VITE_WHATSAPP_NUMBER=
VITE_CONTACT_EMAIL=

# Visitor analytics secrets belong only in the Edge Function environment, never in VITE_* variables:
# VISITOR_ANALYTICS_RATE_LIMIT_HMAC_SECRET
# VISITOR_ANALYTICS_TRUSTED_IP_HEADER
# VISITOR_ANALYTICS_TRUSTED_IP_HEADER_VERIFIED
